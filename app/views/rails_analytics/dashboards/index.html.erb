<section class="ra-kpis">
  <div class="ra-card">
    <span class="ra-kpi-label">Visitas hoje</span>
    <strong class="ra-kpi-value"><%= number_with_delimiter(@stats[:views_today]) %></strong>
  </div>
  <div class="ra-card">
    <span class="ra-kpi-label">Visitas (7 dias)</span>
    <strong class="ra-kpi-value"><%= number_with_delimiter(@stats[:views_7d]) %></strong>
  </div>
  <div class="ra-card">
    <span class="ra-kpi-label">Visitantes únicos (30d)</span>
    <strong class="ra-kpi-value"><%= number_with_delimiter(@stats[:unique_visitors_30d]) %></strong>
  </div>
  <div class="ra-card">
    <span class="ra-kpi-label">Páginas / visita</span>
    <strong class="ra-kpi-value"><%= @stats[:pages_per_visit] %></strong>
  </div>
</section>

<section class="ra-card ra-chart-card">
  <h2 class="ra-card-title">Visitas por dia — últimos 30 dias</h2>
  <div class="ra-chart">
    <%= raw @chart %>
  </div>
</section>

<section class="ra-grid">
  <div class="ra-card">
    <h2 class="ra-card-title">Páginas mais visitadas</h2>
    <% if @stats[:top_pages].any? %>
      <table class="ra-table">
        <thead>
          <tr><th>Página</th><th class="ra-num">Visitas</th></tr>
        </thead>
        <tbody>
          <% @stats[:top_pages].each do |path, count| %>
            <tr>
              <td class="ra-mono"><%= path %></td>
              <td class="ra-num"><%= number_with_delimiter(count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="ra-empty">Nenhuma visita registrada ainda.</p>
    <% end %>
  </div>

  <div class="ra-card">
    <h2 class="ra-card-title">Principais referências</h2>
    <% if @stats[:top_referrers].any? %>
      <table class="ra-table">
        <thead>
          <tr><th>Origem</th><th class="ra-num">Visitas</th></tr>
        </thead>
        <tbody>
          <% @stats[:top_referrers].each do |ref, count| %>
            <tr>
              <td class="ra-mono"><%= ref %></td>
              <td class="ra-num"><%= number_with_delimiter(count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="ra-empty">Nenhuma referência externa ainda.</p>
    <% end %>
  </div>
</section>

<section class="ra-card">
  <h2 class="ra-card-title">Dispositivos (30 dias)</h2>
  <div class="ra-devices">
    <div class="ra-device">
      <span class="ra-kpi-label">Desktop</span>
      <strong class="ra-kpi-value"><%= number_with_delimiter(@stats[:devices][:desktop]) %></strong>
    </div>
    <div class="ra-device">
      <span class="ra-kpi-label">Móvel</span>
      <strong class="ra-kpi-value"><%= number_with_delimiter(@stats[:devices][:mobile]) %></strong>
    </div>
  </div>
</section>